# ==============================================================================
# PracticeKoro 2.0 - Hostinger Apache Configuration (.htaccess)
# Supports Single Page Application (SPA) Client-Side Routing & Static Asset Caching
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prevent rewrite loop for index.html
  RewriteRule ^index\.html$ - [L]

  # 3. Serve existing static files, directories, and symlinks directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 4. Never rewrite missing static assets (scripts, stylesheets, fonts, media) to index.html
  # Returning index.html (200 OK) for missing JS chunks causes dynamic import MIME-type errors.
  # Returning 404 allows Vite preload error listeners to detect stale chunks and auto-reload immediately.
  RewriteCond %{REQUEST_URI} ^/assets/ [OR]
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|eot|ico|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 5. Serve prerendered SEO HTML for /questions and /questions/:questionId/:slug
  RewriteCond %{DOCUMENT_ROOT}/questions/index.html -f
  RewriteRule ^questions/?$ questions/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/questions/$1/index.html -f
  RewriteRule ^questions/([^/]+)(?:/.*)?$ questions/$1/index.html [L]

  # 6. Fallback all SPA routes to /index.html
  # Handles: /, /login, /tests, /tests/:id, /tests/:id/runner, /subscription, /admin, etc.
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ==============================================================================
# MIME TYPES & ENCODING
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/javascript        .js .mjs
  AddType text/css                      .css
  AddType image/svg+xml                 .svg
  AddType application/json              .json
  AddType application/manifest+json     .webmanifest
  AddType font/woff2                    .woff2
  AddType font/woff                     .woff
  AddType image/webp                    .webp
</IfModule>

# ==============================================================================
# BROWSER CACHE CONTROL
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite hashed assets are immutable: cache for 1 year
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 month"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"

  # HTML entry point must not be aggressively cached (ensure updates take effect)
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Cache header for hashed assets
  <FilesMatch "\.(js|css|woff2|woff|webp)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Prevent caching of index.html so updates are immediate
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
